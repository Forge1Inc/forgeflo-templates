{
  "key": "agen",
  "name": "Agen",
  "version": "1.0.0",
  "description": "Polished professional-services site with service cards and consultation CTA",
  "verticals": ["professional_services"],
  "pages": [
    {"file": "index.html", "title": "Home", "core": true},
    {"file": "services.html", "title": "Services", "core": true},
    {"file": "contact.html", "title": "Contact", "core": true}
  ],
  "slots": [
    {"id": "brand_name", "page": "index.html", "type": "text",
     "description": "Business name shown as the nav brand", "maxLen": 40},
    {"id": "hero_title", "page": "index.html", "type": "text",
     "description": "Main headline, punchy, no punctuation at end", "maxLen": 60},
    {"id": "hero_subtitle", "page": "index.html", "type": "text",
     "description": "One-sentence supporting line under the headline", "maxLen": 160},
    {"id": "services_heading", "page": "index.html", "type": "text",
     "description": "Heading of the services section (h2)", "maxLen": 60},
    {"id": "services_intro", "page": "index.html", "type": "text",
     "description": "Short intro paragraph above the service cards", "maxLen": 220},
    {"id": "service_list", "page": "index.html", "type": "list",
     "description": "Service cards, 3-6 items; each item: `<div class=\"col-lg-4 col-sm-6 mb-4\"><div class=\"card hover-bg-secondary shadow py-4 h-100\"><div class=\"card-body text-center\"><div class=\"position-relative\"><i class=\"icon-lg icon-box bg-gradient-primary rounded-circle ti-briefcase mb-5 d-inline-block text-white\"></i><i class=\"icon-lg icon-watermark text-white ti-briefcase\"></i></div><h4 class=\"mb-4\">Service name</h4><p class=\"mb-0\">One-sentence description</p></div></div></div>` — both <i> tags in an item carry the same themify `ti-*` icon class"},
    {"id": "feature_heading", "page": "index.html", "type": "text",
     "description": "Heading of the dark why-choose-us band (h2)", "maxLen": 60},
    {"id": "feature_list", "page": "index.html", "type": "list",
     "description": "Why-choose-us points, exactly 4 items; each item: `<div class=\"col-md-6 mb-4\"><div class=\"media\"><i class=\"icon text-gradient-primary ti-check mr-3\"></i><div class=\"media-body\"><h4 class=\"text-white\">Point title</h4><p class=\"text-light\">One-sentence blurb</p></div></div></div>` — the <i> carries any themify `ti-*` icon class"},
    {"id": "about_heading", "page": "index.html", "type": "text",
     "description": "Heading of the about band (h2)", "maxLen": 60},
    {"id": "about_body", "page": "index.html", "type": "text",
     "description": "Two-to-three sentence description of the business", "maxLen": 400},
    {"id": "booking_heading", "page": "index.html", "type": "text",
     "description": "Heading of the consultation-request band (add-on gated)", "maxLen": 60},
    {"id": "booking_blurb", "page": "index.html", "type": "text",
     "description": "One-sentence blurb above the consultation form", "maxLen": 180},
    {"id": "cta_heading", "page": "index.html", "type": "text",
     "description": "Heading of the call-to-action band (h2)", "maxLen": 60},
    {"id": "cta_text", "page": "index.html", "type": "text",
     "description": "One-sentence call-to-action line", "maxLen": 140},
    {"id": "newsletter_heading", "page": "index.html", "type": "text",
     "description": "Heading of the newsletter band (add-on gated)", "maxLen": 50},
    {"id": "newsletter_blurb", "page": "index.html", "type": "text",
     "description": "One-sentence blurb next to the newsletter signup field", "maxLen": 160},
    {"id": "footer_blurb", "page": "index.html", "type": "text",
     "description": "Short footer description of the business", "maxLen": 160},
    {"id": "contact_phone", "page": "index.html", "type": "text",
     "description": "Phone number as displayed text (footer contact list)", "maxLen": 40},
    {"id": "contact_email_text", "page": "index.html", "type": "text",
     "description": "Email address as displayed text (footer contact list)", "maxLen": 60},
    {"id": "footer_copyright", "page": "index.html", "type": "text",
     "description": "Copyright line in the footer bottom bar", "maxLen": 100},

    {"id": "brand_name", "page": "services.html", "type": "text",
     "description": "Business name shown as the nav brand", "maxLen": 40},
    {"id": "services_page_title", "page": "services.html", "type": "text",
     "description": "Services page title (h1)", "maxLen": 40},
    {"id": "services_heading", "page": "services.html", "type": "text",
     "description": "Heading of the services section (h2), same content as on Home", "maxLen": 60},
    {"id": "services_intro", "page": "services.html", "type": "text",
     "description": "Short intro paragraph above the service cards, same content as on Home", "maxLen": 220},
    {"id": "service_list", "page": "services.html", "type": "list",
     "description": "Service cards, same items and item markup as service_list on index.html: `<div class=\"col-lg-4 col-sm-6 mb-4\"><div class=\"card hover-bg-secondary shadow py-4 h-100\"><div class=\"card-body text-center\"><div class=\"position-relative\"><i class=\"icon-lg icon-box bg-gradient-primary rounded-circle ti-briefcase mb-5 d-inline-block text-white\"></i><i class=\"icon-lg icon-watermark text-white ti-briefcase\"></i></div><h4 class=\"mb-4\">Service name</h4><p class=\"mb-0\">One-sentence description</p></div></div></div>`"},
    {"id": "cta_heading", "page": "services.html", "type": "text",
     "description": "Heading of the call-to-action band (h2), same content as on Home", "maxLen": 60},
    {"id": "cta_text", "page": "services.html", "type": "text",
     "description": "One-sentence call-to-action line, same content as on Home", "maxLen": 140},
    {"id": "footer_blurb", "page": "services.html", "type": "text",
     "description": "Short footer description of the business", "maxLen": 160},
    {"id": "contact_phone", "page": "services.html", "type": "text",
     "description": "Phone number as displayed text (footer contact list)", "maxLen": 40},
    {"id": "contact_email_text", "page": "services.html", "type": "text",
     "description": "Email address as displayed text (footer contact list)", "maxLen": 60},
    {"id": "footer_copyright", "page": "services.html", "type": "text",
     "description": "Copyright line in the footer bottom bar", "maxLen": 100},

    {"id": "brand_name", "page": "contact.html", "type": "text",
     "description": "Business name shown as the nav brand", "maxLen": 40},
    {"id": "contact_page_title", "page": "contact.html", "type": "text",
     "description": "Contact page title (h1)", "maxLen": 40},
    {"id": "contact_heading", "page": "contact.html", "type": "text",
     "description": "Heading above the contact details list (h2)", "maxLen": 60},
    {"id": "contact_phone", "page": "contact.html", "type": "text",
     "description": "Phone number as displayed text (contact list and footer)", "maxLen": 40},
    {"id": "contact_email_text", "page": "contact.html", "type": "text",
     "description": "Email address as displayed text (contact list and footer)", "maxLen": 60},
    {"id": "contact_address", "page": "contact.html", "type": "text",
     "description": "Street address as displayed text", "maxLen": 120},
    {"id": "contact_form_heading", "page": "contact.html", "type": "text",
     "description": "Heading of the lead form card (h3)", "maxLen": 60},
    {"id": "lead_form_button", "page": "contact.html", "type": "text",
     "description": "Submit button label of the lead form", "maxLen": 40},
    {"id": "footer_blurb", "page": "contact.html", "type": "text",
     "description": "Short footer description of the business", "maxLen": 160},
    {"id": "footer_copyright", "page": "contact.html", "type": "text",
     "description": "Copyright line in the footer bottom bar", "maxLen": 100}
  ],
  "sections": [
    {"id": "booking_form", "addOnCode": "booking_form", "page": "index.html"},
    {"id": "newsletter_signup", "addOnCode": "newsletter_signup", "page": "index.html"}
  ],
  "paletteVars": {
    "--fg1-primary": "#f7463a",
    "--fg1-secondary": "#07085d",
    "--fg1-accent": "#b43e79",
    "--fg1-bg": "#ffffff",
    "--fg1-surface": "#f5f6fb",
    "--fg1-text": "#000000",
    "--fg1-muted": "#6c6c86",
    "--fg1-accent-text": "#ffffff",
    "--fg1-heading-font": "\"Noto Sans\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
    "--fg1-body-font": "\"Poppins\", \"Segoe UI\", \"Trebuchet MS\", Arial, sans-serif",
    "--fg1-radius": "35px"
  },
  "files": [
    "pages/index.html",
    "pages/services.html",
    "pages/contact.html",
    "styles.css",
    "site.js",
    "assets/fonts/themify.woff",
    "assets/fonts/themify.ttf"
  ],
  "imageNotes": "No raster images ship with this template: upstream Agen demo photos are demo-only (not licensed for redistribution per the upstream README), so hero, page-title, about and CTA bands are palette-driven CSS gradient bands. Customer photos ride the existing assets pipeline.",
